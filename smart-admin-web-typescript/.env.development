NODE_ENV=development
VITE_APP_TITLE='SmartAdmin 开发环境(Dev)'
VITE_APP_API_URL='http://127.0.0.1:1024'

# 消息传输配置
# 可选值: websocket | rocketmq | hybrid
VITE_MESSAGE_TRANSPORT_TYPE=hybrid

# 混合模式下的主要传输方式
# 可选值: websocket | rocketmq
VITE_MESSAGE_PRIMARY_TRANSPORT=rocketmq

# 混合模式下的降级传输方式
# 可选值: websocket | rocketmq
VITE_MESSAGE_FALLBACK_TRANSPORT=websocket

# 是否开启消息调试模式
VITE_MESSAGE_DEBUG=true