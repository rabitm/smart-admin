NODE_ENV=development
VITE_APP_TITLE='SmartAdmin 开发环境(Dev)'
VITE_APP_API_URL='http://127.0.0.1:1024'

# 消息传输配置
# 可选值: websocket | rocketmq | hybrid
VITE_MESSAGE_TRANSPORT_TYPE=hybrid

# 混合模式下的主要传输方式
# 可选值: websocket | rocketmq
VITE_MESSAGE_PRIMARY_TRANSPORT=rocketmq

# 混合模式下的降级传输方式
# 可选值: websocket | rocketmq
VITE_MESSAGE_FALLBACK_TRANSPORT=websocket

# 是否开启消息调试模式
VITE_MESSAGE_DEBUG=true

# OpenIM 即时通讯配置
# OpenIM服务地址 (localhost部署,使用默认端口)
VITE_OPENIM_API_URL=http://localhost:10002
VITE_OPENIM_WS_URL=ws://localhost:10001
VITE_OPENIM_PLATFORM_ID=5

# OpenIM功能开关
VITE_IM_ENABLED=true
VITE_IM_TEXT_MESSAGE=true
VITE_IM_IMAGE_MESSAGE=true
VITE_IM_FILE_MESSAGE=true
VITE_IM_VOICE_MESSAGE=false
VITE_IM_VIDEO_MESSAGE=false
VITE_IM_AT_MENTION=true
VITE_IM_QUOTE_REPLY=true
VITE_IM_MESSAGE_RECALL=true
VITE_IM_MESSAGE_SEARCH=false

# OpenIM UI配置
VITE_IM_LAYOUT=embedded          # embedded=嵌入式, float=悬浮窗
VITE_IM_MESSAGE_PAGE_SIZE=20     # 消息分页大小
VITE_IM_AUTO_SCROLL=true         # 自动滚动到最新消息
VITE_IM_SHOW_NOTIFICATION=true   # 显示桌面通知
VITE_IM_PLAY_SOUND=true          # 播放提示音