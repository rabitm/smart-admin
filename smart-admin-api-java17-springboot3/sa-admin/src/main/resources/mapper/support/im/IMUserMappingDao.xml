<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.support.im.dao.IMUserMappingDao">

    <resultMap id="BaseResultMap" type="net.lab1024.sa.admin.module.support.im.domain.entity.IMUserMappingEntity">
        <id column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="openim_user_id" property="openimUserId"/>
        <result column="nickname" property="nickname"/>
        <result column="face_url" property="faceUrl"/>
        <result column="sync_status" property="syncStatus"/>
        <result column="sync_time" property="syncTime"/>
        <result column="error_message" property="errorMessage"/>
        <result column="deleted_flag" property="deletedFlag"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据员工ID查询映射 -->
    <select id="selectByEmployeeId" resultMap="BaseResultMap">
        SELECT *
        FROM t_im_user_mapping
        WHERE employee_id = #{employeeId}
          AND deleted_flag = 0
        LIMIT 1
    </select>

    <!-- 根据OpenIM用户ID查询映射 -->
    <select id="selectByOpenimUserId" resultMap="BaseResultMap">
        SELECT *
        FROM t_im_user_mapping
        WHERE openim_user_id = #{openimUserId}
          AND deleted_flag = 0
        LIMIT 1
    </select>

    <!-- 批量查询员工的映射 -->
    <select id="selectByEmployeeIds" resultMap="BaseResultMap">
        SELECT *
        FROM t_im_user_mapping
        WHERE employee_id IN
        <foreach collection="employeeIds" item="employeeId" open="(" separator="," close=")">
            #{employeeId}
        </foreach>
        AND deleted_flag = 0
    </select>

    <!-- 查询指定状态的用户映射 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT *
        FROM t_im_user_mapping
        WHERE sync_status = #{syncStatus}
          AND deleted_flag = 0
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <!-- 查询待同步的用户 (未同步的用户) -->
    <select id="selectPendingSync" resultMap="BaseResultMap">
        SELECT m.*
        FROM t_im_user_mapping m
        WHERE m.openim_user_id IS NULL
          AND m.deleted_flag = 0
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <!-- 查询同步失败的用户 (sync_status = 0) -->
    <select id="selectFailedSync" resultMap="BaseResultMap">
        SELECT *
        FROM t_im_user_mapping
        WHERE sync_status = 0
          AND deleted_flag = 0
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <!-- 更新同步状态 -->
    <update id="updateSyncStatus">
        UPDATE t_im_user_mapping
        SET sync_status = #{syncStatus},
            sync_time = NOW(),
            error_message = #{errorMessage},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 更新用户信息 -->
    <update id="updateUserInfo">
        UPDATE t_im_user_mapping
        SET nickname = #{nickname},
            face_url = #{faceUrl},
            update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>
