<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="net.lab1024.sa.admin.module.business.oa.police.dao.PoliceReportFieldDataDao">

    <!-- 批量插入字段数据 -->
    <insert id="batchInsertFieldData">
        INSERT INTO t_police_report_field_data (
            report_id, field_key, field_value
        ) VALUES
        <foreach collection="fieldDataList" item="fieldData" separator=",">
            (
                #{fieldData.reportId}, #{fieldData.fieldKey}, #{fieldData.fieldValue}
            )
        </foreach>
    </insert>

    <!-- 根据警情ID删除所有字段数据 -->
    <delete id="deleteByReportId">
        DELETE FROM t_police_report_field_data WHERE report_id = #{reportId}
    </delete>

    <!-- 根据警情ID获取字段数据 -->
    <select id="getFieldDataByReportId" resultType="net.lab1024.sa.admin.module.business.oa.police.domain.entity.PoliceReportFieldDataEntity">
        SELECT * FROM t_police_report_field_data
        WHERE report_id = #{reportId}
        ORDER BY field_key
    </select>

</mapper>